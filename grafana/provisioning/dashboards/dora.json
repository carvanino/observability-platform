{
  "title": "DORA Metrics",
  "uid": "dora-dashboard",
  "tags": ["dora", "cicd"],
  "refresh": "5m",
  "time": { "from": "now-30d", "to": "now" },
  "timepicker": { "hidden": true },
  "panels": [
    {
      "id": 1,
      "title": "Deployment Frequency",
      "description": "Deployments per day over last 30 days. Elite ≥ 1/day, High = weekly, Medium = monthly, Low = < monthly",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "dora_deployment_frequency_daily",
          "legendFormat": "Deployments/day"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "mappings": [
            { "type": "range", "options": { "from": 1, "to": 999, "result": { "text": "ELITE", "color": "green" } } },
            { "type": "range", "options": { "from": 0.14, "to": 0.99, "result": { "text": "HIGH", "color": "blue" } } },
            { "type": "range", "options": { "from": 0.03, "to": 0.13, "result": { "text": "MEDIUM", "color": "yellow" } } },
            { "type": "range", "options": { "from": 0, "to": 0.02, "result": { "text": "LOW", "color": "red" } } }
          ],
          "thresholds": {
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "yellow", "value": 0.03 },
              { "color": "blue", "value": 0.14 },
              { "color": "green", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Change Failure Rate",
      "description": "% of deployments causing failures. Elite/High < 15%, Medium 16-30%, Low > 45%",
      "type": "gauge",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "dora_change_failure_rate_percent",
          "legendFormat": "CFR %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 15 },
              { "color": "red", "value": 30 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Lead Time for Changes",
      "description": "Avg time from workflow trigger to completion. Elite < 1h, High < 1d, Medium < 1w",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "dora_lead_time_seconds / 60",
          "legendFormat": "Lead Time (min)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "decimals": 1,
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 60 },
              { "color": "red", "value": 1440 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Mean Time to Restore",
      "description": "Avg time failed workflows take to complete. Proxy for MTTR. Elite < 1h, High < 1d",
      "type": "stat",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "dora_mttr_seconds / 60",
          "legendFormat": "MTTR (min)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "decimals": 1,
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 60 },
              { "color": "red", "value": 1440 }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Total Deployments (30 days)",
      "type": "stat",
      "gridPos": { "x": 0, "y": 8, "w": 6, "h": 6 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "dora_deployments_total",
          "legendFormat": "Total"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" }
      }
    },
    {
      "id": 6,
      "title": "Failed Deployments (30 days)",
      "type": "stat",
      "gridPos": { "x": 6, "y": 8, "w": 6, "h": 6 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "dora_deployments_failed_total",
          "legendFormat": "Failed"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 3 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      }
    },
    {
      "id": 7,
      "title": "Deployment Frequency Trend",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 6 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "dora_deployment_frequency_daily",
          "legendFormat": "Deployments/day"
        }
      ]
    }
  ]
}
